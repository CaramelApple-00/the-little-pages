---
import Layout from '../layouts/Layout.astro';
---
<Layout title="The Little Pages">
  <section class="hero">
    <div class="hero-label">welcome to</div>
    <div class="hero-lines heading">
      A collection of <em>little pages</em> —<br />
      poems, half-formed thoughts,<br />
      and the parts of a life<br />
      worth writing down.
    </div>
    <p class="hero-sub">
      Some pages are poems. Some are just Tuesdays. All of them are true at the time
      they were written — nothing here is polished into something it wasn't.
    </p>
  </section>

  <hr class="divider" />

  <div class="home-grid">
    <div class="home-card">
      <span class="kicker">poetry</span>
      <h3 class="heading">The pages that rhyme</h3>
      <p>Where the feelings that don't fit in a sentence go instead. Unedited, mostly unresolved, on purpose.</p>
      <a class="enter" href="/poetry">Read the poems</a>
    </div>
    <div class="home-card">
      <span class="kicker">blog</span>
      <h3 class="heading">The pages in between</h3>
      <p>Longer thoughts. Things I'm figuring out in real time, written the way I'd tell a friend, not the way I'd write an essay.</p>
      <a class="enter" href="/blog">Read the blog</a>
    </div>
    <div class="home-card">
      <span class="kicker">vlog</span>
      <h3 class="heading">The pages out loud</h3>
      <p>For the days a page isn't enough — when it needs a voice and a face and a little less editing.</p>
      <a class="enter" href="/vlog">Watch the vlog</a>
    </div>
  </div>
</Layout>

<style>
  .hero { padding: 80px 0 56px; max-width: 680px; }
  .hero-label { font-size: 14px; color: var(--ink-soft); margin-bottom: 18px; }
  .hero-lines {
    font-size: clamp(34px, 4.8vw, 50px);
    line-height: 1.3;
    color: var(--ink);
    opacity: 0;
    animation: rise 1s ease forwards;
  }
  .hero-lines em { font-style: italic; color: var(--cocoa); }
  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-sub {
    margin-top: 28px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 520px;
  }

  .home-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 56px;
    padding-bottom: 56px;
  }
  @media (max-width: 760px) { .home-grid { grid-template-columns: 1fr; gap: 40px; } }

  .home-card h3 { font-size: 25px; letter-spacing: 0.2px; margin: 0 0 10px; color: var(--cocoa); }
  .home-card .kicker { font-size: 13px; color: var(--gold); margin-bottom: 8px; display: block; }
  .home-card p { font-family: 'Cormorant Garamond', serif; font-size: 17px; line-height: 1.55; color: var(--ink-soft); margin: 0 0 14px; }

  .enter {
    font-size: 14px;
    color: var(--cocoa);
    text-decoration: none;
    border-bottom: 1px solid var(--gold-soft);
    font-family: 'Work Sans', sans-serif;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .enter:hover { color: var(--gold); border-bottom-color: var(--gold); }
</style>
